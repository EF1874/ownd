# ==============================================================================
# Ownd API 生产环境配置模板 (.env.production)
# 部署前请务必复制此文件并重命名为 .env.production，并修改所有的敏感密钥！
# ==============================================================================

# App 基础配置
NODE_ENV=production
PORT=3000

# CORS 跨域配置 (设置为前端访问后端所使用的 IP 或本地地址，支持逗号分隔多个)
# 例如，如果前端部署在 http://127.0.0.1:8080，则填写该地址
CORS_ORIGIN=https://localhost,https://127.0.0.1

# JWT 安全密钥 (必须修改！使用 openssl rand -base64 32 生成一个强密钥)
JWT_SECRET=change_me_to_a_long_random_and_secure_jwt_secret_key_2026

# PostgreSQL 数据库配置 (必须修改密码！)
POSTGRES_USER=ownd_prod_user
POSTGRES_PASSWORD=change_me_to_a_secure_db_password_12345
POSTGRES_DB=ownd_prod_db
DATABASE_URL=postgresql://ownd_prod_user:change_me_to_a_secure_db_password_12345@postgres:5432/ownd_prod_db?schema=public

# Redis 配置 (内部容器间通信，无需公网暴露端口)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO 对象存储配置 (必须修改密码！)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ownd-items
MINIO_ROOT_USER=ownd_minio_admin
MINIO_ROOT_PASSWORD=change_me_to_a_secure_minio_password_54321

