# ==============================================================================
# Ownd API Production Environment Template (.env.production.example)
# 
# Copy this file to '.env.production' before deploying to production.
# ==============================================================================

# App 基础配置
NODE_ENV=production
PORT=3000

# CORS 跨域配置 (支持逗号分隔多个地址)
CORS_ORIGIN=https://localhost,https://127.0.0.1

# JWT 安全密钥 (必须修改！使用 openssl rand -base64 32 生成一个强密钥)
JWT_SECRET=change_me_to_a_long_random_and_secure_jwt_secret_key_2026

# PostgreSQL 数据库配置 (必须修改密码！)
POSTGRES_USER=ownd_prod_user
POSTGRES_PASSWORD=change_me_to_a_secure_db_password_12345
POSTGRES_DB=ownd_prod_db
DATABASE_URL=postgresql://ownd_prod_user:change_me_to_a_secure_db_password_12345@postgres:5432/ownd_prod_db?schema=public

# Redis 配置 (内部容器间通信，无需公网暴露端口)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO 对象存储配置 (必须修改密码！)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ownd-items
MINIO_ROOT_USER=ownd_minio_admin
MINIO_ROOT_PASSWORD=change_me_to_a_secure_minio_password_54321

# 应用更新发布配置
# GitHub Actions 会把 Android APK 和正式 latest.json 上传到该 bucket。
# 本地和正式都使用 latest.json，通过不同地址隔离。
MINIO_RELEASES_BUCKET=ownd-releases
APP_UPDATE_ANDROID_MANIFEST_URL=https://download.ownd.cc/android/latest.json

# SMTP 邮件配置 (必须修改为真实邮箱服务凭证)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=your_production_email_password_or_auth_code
SMTP_FROM="物记" <sender@example.com>
