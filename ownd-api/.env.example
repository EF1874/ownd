# ==============================================================================
# Ownd API Development Environment Template (.env.example)
# 
# Copy this file to '.env.development' for local development.
# ==============================================================================

# App 基础配置
NODE_ENV=development
PORT=3000

# JWT 安全密钥 (开发环境可保留，生产环境必须更换)
JWT_SECRET=change_me_to_a_long_random_and_secure_jwt_secret_key_2026

# PostgreSQL 数据库配置
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ownd
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/ownd?schema=public"

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 应用更新调试配置
# 本地和正式都使用 latest.json，通过不同地址隔离。
APP_UPDATE_ANDROID_MANIFEST_URL=http://127.0.0.1:3100/latest.json

# SMTP 邮件配置 (用于开发测试发送真实验证码)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=your_email_password_or_auth_code
SMTP_FROM="物记" <sender@example.com>
