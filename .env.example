# App
NODE_ENV=production
PORT=3000
API_DOMAIN=api.example.com
CORS_ORIGIN=https://api.example.com

# PostgreSQL
POSTGRES_USER=ownd
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ownd
DATABASE_URL=postgresql://ownd:change-me-postgres-password@postgres:5432/ownd?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_DOMAIN=files.example.com
MINIO_CONSOLE_DOMAIN=minio.example.com
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ownd-items
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
